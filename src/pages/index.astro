---
import ProfileCard from "../components/ProfileCard.astro";
import { profile } from "../data/profile";
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Gabriel Garoz | Software Engineering & Architecture";
const description =
  "Gabriel Garoz, software engineer and architect. Experience across AI and automation, websites, applications, cloud infrastructure, and platform engineering.";
---

<BaseLayout title={title} description={description} image={profile.portrait.src}>
  <main class="site-shell">
    <ProfileCard profile={profile} />
  </main>
</BaseLayout>
