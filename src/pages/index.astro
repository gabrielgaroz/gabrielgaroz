---
import ProfileCard from "../components/ProfileCard.astro";
import { profile } from "../data/profile";
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Gabriel Garoz | Software Engineering & Architecture";
const description =
  "Software engineering and architecture by Gabriel Garoz. Practical AI solutions, websites, web applications, cloud infrastructure, and platform engineering.";
---

<BaseLayout title={title} description={description} image={profile.portrait.src}>
  <main class="site-shell">
    <ProfileCard profile={profile} />
  </main>
</BaseLayout>
