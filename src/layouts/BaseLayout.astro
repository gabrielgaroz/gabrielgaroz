---
import Analytics from "../components/Analytics.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import { locales, type Locale, type LocalizedContent } from "../data/localization";
import "../styles/global.css";

interface Props {
  locale: Locale;
  content: LocalizedContent;
}

const { locale, content } = Astro.props;
const { profile, metadata } = content;
const { title, description } = metadata;
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
const siteUrl = Astro.site ?? Astro.url.origin;
const canonicalUrl = new URL(getRelativeLocaleUrl(locale), siteUrl);
const defaultUrl = new URL(getRelativeLocaleUrl("en"), siteUrl);
const imageUrl = new URL(profile.portrait.src, siteUrl);
const ogLocales: Record<Locale, string> = { en: "en_US", es: "es_GT" };

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.name,
  url: canonicalUrl.toString(),
  image: imageUrl.toString(),
  description,
  jobTitle: metadata.jobTitle,
  sameAs: [profile.linkedInUrl],
  knowsAbout: metadata.knowsAbout,
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content="Gabriel Garoz" />
    <meta name="theme-color" content="#26384a" />

    <link rel="canonical" href={canonicalUrl} />
    {locales.map((language) => (
      <link rel="alternate" hreflang={language} href={new URL(getRelativeLocaleUrl(language), siteUrl)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={defaultUrl} />
    <link rel="icon" href={`${basePath}/favicon.svg`} type="image/svg+xml" />

    <meta property="og:type" content="profile" />
    <meta property="og:locale" content={ogLocales[locale]} />
    {locales.filter((language) => language !== locale).map((language) => (
      <meta property="og:locale:alternate" content={ogLocales[language]} />
    ))}
    <meta property="og:site_name" content="Gabriel Garoz" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="profile:first_name" content="Gabriel" />
    <meta property="profile:last_name" content="Garoz" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <title>{title}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <slot />
    <Analytics />
  </body>
</html>
