---
import Analytics from "../components/Analytics.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  image: string;
}

const { title, description, image } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const imageUrl = new URL(image, Astro.site ?? Astro.url.origin);

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Gabriel Garoz",
  url: canonicalUrl.toString(),
  image: imageUrl.toString(),
  description,
  jobTitle: "Staff Software Architect — Cloud, Platform & AI",
  sameAs: ["https://www.linkedin.com/in/gabrielgaroz/"],
  knowsAbout: [
    "Cloud infrastructure",
    "Kubernetes",
    "Google Cloud",
    "Platform engineering",
    "DevOps",
    "AI-driven automation",
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content="Gabriel Garoz" />
    <meta name="theme-color" content="#26384a" />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content="Gabriel Garoz" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="profile:first_name" content="Gabriel" />
    <meta property="profile:last_name" content="Garoz" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <title>{title}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <slot />
    <Analytics />
  </body>
</html>
