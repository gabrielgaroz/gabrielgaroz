---
import type { Profile } from "../data/profile";

interface Props {
  profile: Profile;
}

const { profile } = Astro.props;
---

<article class="profile-card">
  <div class="architectural-grid" aria-hidden="true">
    <span></span><span></span><span></span>
  </div>

  <header class="profile-header">
    <p class="profile-kicker">Designing systems that endure</p>

    <div class="portrait-stage">
      <span class="portrait-orbit" aria-hidden="true"></span>
      <img
        class="profile-portrait"
        src={profile.portrait.src}
        alt={profile.portrait.alt}
        width="176"
        height="176"
        decoding="async"
        fetchpriority="high"
      />
    </div>

    <div class="profile-identity">
      <p class="profile-discipline" aria-hidden="true">Engineering · Architecture</p>
      <h1>{profile.name}</h1>
      <p class="profile-role">{profile.role}</p>
      <p class="profile-introduction">{profile.introduction}</p>
    </div>

    <ul class="practice-map" aria-label="Areas of focus">
      {profile.practices.map((practice) => <li>{practice}</li>)}
    </ul>
  </header>

  <div class="profile-content">
    <section class="biography" aria-label="About Gabriel">
      {profile.biography.map((paragraph) => <p>{paragraph}</p>)}
    </section>

    <section class="focus-areas" aria-labelledby="focus-heading">
      <h2 class="section-heading" id="focus-heading">Areas of focus</h2>
      <ul class="focus-list">
        {profile.focusAreas.map((area) => (
          <li>
            <h3>{area.title}</h3>
            <p>{area.description}</p>
          </li>
        ))}
      </ul>
    </section>

    <footer class="profile-footer">
      <a
        class="primary-action"
        href={profile.primaryAction.url}
        target="_blank"
        rel="me noopener noreferrer"
        aria-label={profile.primaryAction.accessibleLabel}
        data-analytics-event="contact_clicked"
        data-analytics-destination="linkedin"
        data-analytics-placement="primary_action"
      >
        <span>{profile.primaryAction.label}</span>
        <svg aria-hidden="true" viewBox="0 0 24 24">
          <path d="M7.8 5.4 14.4 12l-6.6 6.6 1.8 1.8 8.4-8.4-8.4-8.4-1.8 1.8Z" />
        </svg>
      </a>
      <a
        class="secondary-action"
        href={profile.secondaryAction.url}
        aria-label={profile.secondaryAction.accessibleLabel}
        data-analytics-event="contact_clicked"
        data-analytics-destination="email"
        data-analytics-placement="secondary_action"
      >{profile.secondaryAction.label}</a>
    </footer>
  </div>
</article>
